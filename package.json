{
  "name": "ashan-ai-desktop",
  "version": "0.1.0-opensource",
  "description": "Open source reconstruction of Ashan.ai desktop application (UMKM AI agent)",
  "productName": "Ashan.ai",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron . --no-sandbox",
    "build": "tsc && vite build",
    "package": "electron-builder --win",
    "preview": "vite preview"
  },
  "build": {
    "appId": "io.ashan.ai",
    "productName": "Ashan.ai",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "electron": "^32.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron-builder": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morluto/ashan-ai-desktop-open.git"
  },
  "keywords": [
    "ashan-ai",
    "umkm",
    "whatsapp-business",
    "electron",
    "ai-agent",
    "reverse-engineering"
  ],
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  }
}
